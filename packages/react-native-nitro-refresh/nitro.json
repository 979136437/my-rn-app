{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["refresh"],
  "ios": { "iosModuleName": "NitroRefresh" },
  "android": {
    "androidNamespace": ["refresh"],
    "androidCxxLibName": "NitroRefresh"
  },
  "autolinking": {
    "RefreshController": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRefreshController"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRefreshController"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": false
}
