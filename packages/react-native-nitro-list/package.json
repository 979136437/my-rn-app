{
  "name": "react-native-nitro-list",
  "version": "0.1.0",
  "description": "Fabric recycler list with Nitro control and reusable React slots",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": ["src", "android", "ios", "nitrogen", "NitroList.podspec", "nitro.json", "react-native.config.js", "README.md"],
  "scripts": { "codegen:nitro": "nitrogen" },
  "dependencies": { "react-native-nitro-viewability": "workspace:*" },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-native": ">=0.86.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": ">=4.0.0"
  },
  "devDependencies": { "nitrogen": "0.37.1" },
  "codegenConfig": {
    "name": "NitroListSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": { "javaPackageName": "com.nitrolist" },
    "ios": {
      "componentProvider": {
        "NitroListView": "NitroListComponentView",
        "NitroListSlotView": "NitroListSlotComponentView"
      }
    }
  }
}
